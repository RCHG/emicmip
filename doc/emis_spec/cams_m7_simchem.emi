#   2.9 DMS --------------------------------------------------------------------

species=DMS,         sector=emi_oceans: paramid=212131
species=DMS,         sector=emiss_bio:  paramid=212132

#===============================================================================
# ** 3 DISTRIBUTION 

#   3.1 Anthro diurnal cycles --------------------------------------------------
sector=agl/ags/ene/fef/ind/res/shp/slv/swd/tnr/tro: diurnal_cycle_type=CAMS_GLOB_{sector^}
sector=ref: diurnal_cycle_type=CAMS_GLOB_ENE # until it's in the source code
sector=com: diurnal_cycle_type=CAMS_GLOB_RES # until it's in the source code

sector=ene/ref: vertical_profile_type=HeightRange, vertical_base_height=200, vertical_top_height=800
sector=ind: vertical_profile_type=HeightRange, vertical_base_height=20, vertical_top_height=300
sector=shp: vertical_profile_type=HeightRange, vertical_base_height=30, vertical_top_height=100
sector=swd: vertical_profile_type=HeightRange, vertical_base_height=20, vertical_top_height=100

sector==ene_SOA/ind_SOA/tro_SOA/tnr_SOA/shp_SOA/slv_SOA/agl_SOA/ags_SOA/awb_SOA/swd_SOA/fef_SOA/emiss_bio: vertical_profile_type=HeightRange, vertical_base_height=100, vertical_top_height=500


#    3.2 Diurnal cycle for biomass-burning emissions ---------------------------
sector=Biomass-burning: diurnal_cycle_type=GFAS, diurnal_peak_hour=13.5, diurnal_baseline=0.2

#    3.3 Spatial interpolation of biomass-burning emissions --------------------
sector=Biomass-burning: prespatial=box_avg

