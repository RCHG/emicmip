# ╭────────────────────────────────────────────────────────────────────────────╮
# │                                                        (update 2026-05-30) │
# │ Emission specification for historical                                      │ 
# │                                                                            │
# │ - SOURCE -> CAMS                                                           │ 
# │ - AER    -> HAMM7                                                          │
# │ - CHEM   -> SIMCHEM                                                        │
# │                                                                            │
# │ Contact: Ramiro Checa-Garcia (KNMI)                                        │
# │                                                                            │
# │ species=NH3 (emiss_bio) commented as not present in cmip7 files            │
# │                                                                            │
# │ This file is organized in sections as:                                     │
# │                                                                            │
# │   1. SOURCES       => describes sources (paths)                            │
# │   2. SPECIFICATION => describes specification per group                    │
# │   3. DISTRIBUTION  => Vertical Distribution and Diurnal Cycle              │
# ╰────────────────────────────────────────────────────────────────────────────╯

#===============================================================================
# ** 1.0 SOURCES 
#
# *** 1.1 Natural Emissions (biogenic, soil, volcanos) -------------------------
#
#     Sources: CAMS, TM5_DMS, CAMS-volcanos, JUELICH- MACC-reanalysis 
#
species!=DMS/SO2/NH3, sector==emiss_bio: src=ec:/eccams/Emis/CAMS-GLOB-BIO/v3.1/climatology/CAMS-GLOB-BIO_v3.1_{xfvar|_tag|species}.clim_2013-2022.nc, preconvert=cdo_grib1:emiss_bio:-setgrid,global_0.25:-settaxis,{year}-01-15,0,1mon, prespatial=box_avg, pretemporal=timeint
species=DMS,          sector=emi_oceans: src=ec:/cxal/Emis/DMS/CAMS-GLOB-OCE_v3.1_DMS_clim2000-2021.nc, preconvert=cdo_grib1:emi_oceans:-settaxis,{year}-01-01,0,1mon, prespatial=box_avg, pretemporal=timeint_shiftmonth
species=DMS,          sector=emiss_bio:  src=file:/ec/res4/hpcperm/nk9/CAMS/Emis/old_sources/TM5_DMS/TM5_surface_DMS_0000.0.5x0.5.nc, preconvert=cdo_grib1:emis:-settaxis,{year}-01-15,0,1mon, prespatial=box_avg, pretemporal=timeint
#species=NH3,         sector=emiss_bio:  src=file:/ec/res4/hpcperm/nk9/CAMS/Emis/old_sources/MACC_NRT/JUELICH_MACC_reanalysis_{xfvar|_tag|species}_2008_0.5x0.5_kg.nc, prespatial=box_avg, pretemporal=timeint, prencrename=-a:time@unit,time@units, preconvert=cdo_grib1:emiss_soil

# Use for simplified chemistry only, when no explicit DMS chemistry treatment in the model. Scale factor 'scaling': xmSO2/xmDMS = 64.07/62.13=1.03, assuming yield is unity
species=SO2,  sector=emi_oceans:  src=ec:/cxal/Emis/DMS/CAMS-GLOB-OCE_v3.1_DMS_clim2000-2021.nc, preconvert=cdo_grib1:emi_oceans:-settaxis,{year}-01-01,0,1mon, prespatial=box_avg, pretemporal=timeint_shiftmonth
species=SO2,  sector=emiss_bio:   src=file:/ec/res4/hpcperm/nk9/CAMS/Emis/old_sources/TM5_DMS/TM5_surface_DMS_0000.0.5x0.5.nc, preconvert=cdo_grib1:emis:-settaxis,{year}-01-15,0,1mon, prespatial=box_avg, pretemporal=timeint
species==SO2, sector==emiss_bio:  prescaling*=1.03
species==SO2, sector==emi_oceans: prescaling*=1.03
species=SO2,  sector=emi_oceans:  paramid=216151
species=SO2,  sector=emiss_bio:   paramid=216152

# SO2 volcano heights (chemistry and aerosol)

sector=emiss_vol: src=ec:/cxal/Emis/Volcanoes/CAMS-GLOB-VOLC-CLIM-2005-2021-V1.nc, preconvert=cdo_grib1:emiss_nat_CAMS_MEAN:-settaxis,{year}-01-01,0,1mon, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=emiss_vol: vertical_profile_type=AltitudeMap, vertical_paramid=216045, vertical_base_level=-1, vertical_top_level=-4, vertical_threshold=200
paramid=216045: src=file:/ec/res4/hpcperm/nk9/CAMS/Emis/emis_aux/volcanoes/volcanoes.grb_05, prespatial=box_max


# *** 1.2 Anthropogenic Emissions (surface) ------------------------------------
# ene=energy, ind=industry, shp=shipping, slv=solvent, res=residencial, 
# com=commer. agl+ags=agriculture, tnr+tro=transport

sector=awb/agl/ags/ene/fef/fef_gas/fef_oil/fef_coal/ind/ref/res/com/shp/slv/swd/tnr/tro: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:{sector}, prespatial=box_avg, pretemporal=timeint_shiftmonth

# *** 1.3 SOA sectors ----------------------------------------------------------
# additions for SOA: 
# fuel (fef), energy, industry, transport (tro, tnr), ships, solvents, agriculture (ags, agl), waste (awb, swd) 
sector=ene_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:ene, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=ind_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:ind, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=tro_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:tro, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=tnr_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:tnr, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=shp_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:shp, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=slv_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:slv, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=agl_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:agl, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=ags_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:ags, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=awb_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:awb, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=swd_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:swd, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=fef_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:fef, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=ref_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:ref, prespatial=box_avg, pretemporal=timeint_shiftmonth
sector=com_SOA: src=ec:/eccams/Emis/CAMS-GLOB-ANT/v6.2/{year}/CAMS-GLOB-ANT_v6.2_{xfvar|_tag.|species.}_{year}.nc, preconvert=cdo_grib1:com, prespatial=box_avg, pretemporal=timeint_shiftmonth

# *** 1.4 Aircraft emissions ---------------------------------------------------
sector=Aviation: vertical_profile_type=3D, src=ec:/eccams/Emis/CAMS-GLOB-AIR/CAMS-GLOB-AIR_Glb_0.5x0.5_anthro_2020.tar#CAMS-GLOB-AIR_Glb_0.5x0.5_anthro_{xfvar|_tag.|species.}_2020.nc, prespatial=box_avg, preconvert=cdo_grib2:-setyear,2010:-setzaxis,/home/eccams/data/cifs_input/emis_aux/AIR_AUX_V1/AIR_AUX.zaxis.L{levels}:-selname,avi:-mul:-intlevelx3d,/home/eccams/data/cifs_input/emis_aux/AIR_AUX_V1/AIR_AUX.z.L{levels}.nc:-divc,610::-expr,z=clev(avi)*1e3+avi*0::/home/eccams/data/cifs_input/emis_aux/AIR_AUX_V1/AIR_AUX.thickness.L{levels}.nc, pretemporal=timeint_shiftmonth

# *** 1.5 Biomass-burning emissions --------------------------------------------
# ... uncomment for NRT (near-real-time)
#sector=Biomass-burning: vertical_profile_type=GFAS, vertical_paramid=210060
#paramid=210060: src=gfas:INJH, prespatial=box_max

species=BC_*,          sector=Biomass-burning: src=gfas:{_tag}, paramid={src}
species=POM_KI/POM_AS, sector=Biomass-burning: src=gfas:{_tag}, paramid={src}
species=DMS,           sector=Biomass-burning: src=gfas:{species}, paramid={src}
species=SO2,           sector=Biomass-burning: src=gfas:{species}, paramid={src}

# ==============================================================================
# *** 2.0 SPECIFICATION 
species=BC_KI: _tag=BC
species=BC_AS: _tag=BC

#   2.1  Biomass Burning: partition in BC_KI and BC_AS -------------------------

#species=BC_KI, sector=Biomass-burning: paramid=219050  # assigned by GFAS 
#species=BC_AS, sector=Biomass-burning: paramid=219051  # assigned by GFAS 

species=BC_KI, sector=Biomass-burning: scaling*=0.05,  precap=0.00000001, PSD_RADIUS=0.03E-6,  PSD_SIGMA=1.59, PSD_N0_TRACER="KI_N", MASS_DENSITY=1800
species=BC_AS, sector=Biomass-burning: scaling*=0.95,  precap=0.00000001, PSD_RADIUS=0.075E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="AS_N", MASS_DENSITY=1800

#   2.2  Other Sectors: only emissions in BC_KI  -------------------------------
species=BC_KI, sector!=Biomass-burning: scaling*=1.00, precap=0.00000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KI_N", MASS_DENSITY=1800

species=BC_KI, sector=ene: paramid=212221
species=BC_KI, sector=fef: paramid=212222
species=BC_KI, sector=ind: paramid=212223
species=BC_KI, sector=res: paramid=212224
species=BC_KI, sector=shp: paramid=212225
species=BC_KI, sector=swd: paramid=212226
species=BC_KI, sector=tnr: paramid=212227
species=BC_KI, sector=tro: paramid=212228
species=BC_KI, sector=ref: paramid=212229
species=BC_KI, sector=com: paramid=216119
species=BC_KI, sector=awb: paramid=216142

#   2.3 Organic Matter (POM) --------------------------------------------------- 
species=POM_KS, sector==emiss_bio: xfexpr=(alpha_pinene+beta_pinene+other_monoterpenes)*0.077
species=POM_AS: _tag=OC
species=POM_KI: _tag=OC

species=POM_KS, sector=emiss_bio: paramid=216177, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300

species=POM_KS, sector==ene_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==ind_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==tro_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==tnr_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==shp_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==awb_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==fef_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==swd_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==ref_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
species=POM_KS, sector==com_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
#species=POM_KS, sector==swd_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed
#species=POM_KS, sector==fef_SOA:  _tag=CO, prescaling*=0.049  # probably a new scaling is needed

species=POM_KS, sector!=ene_SOA/ind_SOA/tro_SOA/tnr_SOA/shp_SOA/awb_SOA/swd_SOA/fef_SOA/ref_SOA/com_SOA/emiss_bio/Biomass-burning: _tag=OC

species=POM_KS, sector=ene_SOA: paramid=216165, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=ind_SOA: paramid=216166, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=tro_SOA: paramid=216167, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=tnr_SOA: paramid=216168, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=shp_SOA: paramid=216169, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=awb_SOA: paramid=216174, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=fef_SOA: paramid=216176, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=swd_SOA: paramid=216175, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=com_SOA: paramid=216172, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
species=POM_KS, sector=ref_SOA: paramid=216171, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300

#species=POM_KS, sector=ags_SOA: paramid=216173, precap=0.000000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1300
