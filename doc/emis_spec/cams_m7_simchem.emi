#   2.4 Biomass Burning: partition in POM_KI and POM_AS ------------------------
#species=POM_AS, sector=Biomass-burning: paramid=219032 # assigned by GFAS 
#species=POM_KI, sector=Biomass-burning: paramid=219033 # assigned by GFAS

species=POM_KI, sector=Biomass-burning: scaling*=0.08, precap=0.00000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KI_N", MASS_DENSITY=1300
species=POM_AS, sector=Biomass-burning: scaling*=1.52, precap=0.00000001, PSD_RADIUS=0.075E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="AS_N", MASS_DENSITY=1300

species=POM_KI, sector!=Biomass-burning: scaling*=1.60, precap=0.00000001, PSD_RADIUS=0.03E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="KI_N", MASS_DENSITY=1300

#   2.5 Other Sectors: only emissions in POM_KI  -------------------------------
species=POM_KI, sector=ene: paramid=212231
species=POM_KI, sector=fef: paramid=212232
species=POM_KI, sector=ind: paramid=212233
species=POM_KI, sector=res: paramid=212234
species=POM_KI, sector=shp: paramid=212235
species=POM_KI, sector=swd: paramid=212236
species=POM_KI, sector=tnr: paramid=212237
species=POM_KI, sector=tro: paramid=212238
species=POM_KI, sector=ref: paramid=212239
species=POM_KI, sector=com: paramid=216120
species=POM_KI, sector=awb: paramid=216143


#   2.6 Sulphate Aerosols ------------------------------------------------------
#       scaling factor all sectors and modes 0.025 (2.5%) 

species=SO4_*: _tag=SO2
species=SO4_AS, sector=Biomass-burning: paramid=219054, src=gfas:SO2

