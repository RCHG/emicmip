species=SO4_AS, sector=ene/ind/shp:         scaling*=0.01878, precap=0.00000001, PSD_RADIUS=0.075E-6, PSD_SIGMA=1.59, PSD_N0_TRACER="AS_N", MASS_DENSITY=1841
species=SO4_CS, sector=ene/ind/shp:         scaling*=0.01878, precap=0.00000001, PSD_RADIUS=0.75E-6,  PSD_SIGMA=2.00, PSD_N0_TRACER="CS_N", MASS_DENSITY=1841
species=SO4_KS, sector=awb/tro/tnr/:        scaling*=0.03757, precap=0.00000001, PSD_RADIUS=0.03E-6,  PSD_SIGMA=1.59, PSD_N0_TRACER="KS_N", MASS_DENSITY=1841

